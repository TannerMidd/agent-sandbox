{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sandbox.dev/schemas/preset.v1.json",
  "title": "Agent Sandbox preset manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "version", "executable", "minimumRuntime", "authenticationHint", "lastVerified", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "executable": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "minimumRuntime": { "type": "string" },
    "authenticationHint": { "type": "string" },
    "lastVerified": { "type": "string", "format": "date" },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "architecture", "source", "integrity", "installKind"],
        "properties": {
          "platform": { "const": "linux" },
          "architecture": { "const": "x64" },
          "source": { "type": "string" },
          "integrity": { "type": "string", "pattern": "^sha512-" },
          "installKind": { "const": "npm" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
