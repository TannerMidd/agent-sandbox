{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-sandbox.dev/schemas/guest-file-request.v1.json",
  "title": "Agent Sandbox guest file request v1",
  "type": "object",
  "required": ["v", "id", "op", "rootId", "relativePath"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "op": { "enum": ["list", "stat", "search", "upload", "download", "stageDownload", "mkdir", "createFile", "rename", "copy", "move", "trash", "restore", "purge", "readText", "writeText", "chmod", "archive", "extract"] },
    "rootId": { "enum": ["work", "system"] },
    "relativePath": { "$ref": "#/$defs/path" },
    "destinationPath": { "$ref": "#/$defs/path" },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
    "cursor": { "type": ["string", "null"] },
    "conflict": { "enum": ["fail", "overwrite", "rename"] },
    "content": { "type": ["string", "null"] },
    "mode": { "type": ["integer", "null"], "minimum": 0, "maximum": 511 },
    "expected": {
      "oneOf": [
        { "$ref": "#/$defs/expectation" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "stageDownload" } }, "required": ["op"] },
      "then": { "required": ["destinationPath", "expected"] }
    }
  ],
  "$defs": {
    "path": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$" }
    },
    "expectation": {
      "type": "object",
      "required": ["kind", "size", "mtimeNs", "mode"],
      "properties": {
        "kind": { "enum": ["file", "directory"] },
        "size": { "type": "integer", "minimum": 0 },
        "mtimeNs": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
