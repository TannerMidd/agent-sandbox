<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>AgentSandbox-x64</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.6</PackageVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);PackageVersion=$(PackageVersion)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- Some self-contained Windows App SDK binaries expose non-LANGID version resources. -->
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>
</Project>
