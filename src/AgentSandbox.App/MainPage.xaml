<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AgentSandbox.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AgentSandbox.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <NavigationView x:Name="ShellNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Left" OpenPaneLength="244" CompactPaneLength="52"
                    Background="{ThemeResource NavigationPaneBackgroundBrush}"
                    Loaded="ShellNavigation_Loaded"
                    SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="8,12" Spacing="2">
                <TextBlock Text="AGENT SANDBOX" FontWeight="SemiBold" Foreground="{StaticResource SandboxAccentBrush}" />
                <TextBlock Text="PUBLIC BETA" FontSize="11" Opacity="0.55" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="Dashboard" IsSelected="True">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="FilesNavigationItem" Content="Files" Tag="Files">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Snapshots &amp; Recovery" Tag="Recovery">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE777;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DiagnosticsNavigationItem" Content="Diagnostics" Tag="Diagnostics">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid Background="{ThemeResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="32,22,32,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Manage your isolated agent development environment" Opacity="0.58" Margin="0,3,0,0" />
                </StackPanel>
                <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Active VM" FontSize="12" Opacity="0.62" Margin="0,0,0,4" />
                    <ComboBox x:Name="SandboxPicker" Grid.Row="1" MinWidth="190" VerticalAlignment="Stretch"
                              AutomationProperties.Name="Active VM"
                              ItemsSource="{x:Bind ViewModel.Sandboxes}" DisplayMemberPath="InstanceName"
                              SelectionChanged="SandboxPicker_SelectionChanged" />
                    <Button Grid.Row="1" Grid.Column="1" Content="New VM" Click="CreateSandbox_Click" VerticalAlignment="Stretch" />
                    <ProgressRing Grid.Row="1" Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button Grid.Row="1" Grid.Column="3" Command="{x:Bind ViewModel.RefreshSandboxCommand}" ToolTipService.ToolTip="Refresh status" VerticalAlignment="Stretch">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </Grid>
            </Grid>
            <InfoBar Grid.Row="1" Margin="32,0,32,12" IsOpen="True" IsClosable="False" Severity="Error"
                     Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="DashboardPanel">
                    <StackPanel Margin="32,8,32,32" Spacing="18">
                        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.SetupVisibility, Mode=OneWay}"
                                Background="{ThemeResource SetupBackgroundBrush}" BorderBrush="{ThemeResource SetupBorderBrush}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="GUIDED SETUP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SandboxAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SetupHeading, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SetupDetail, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Opacity="0.74" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.SetupActionLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.ContinueSetupCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="18" RowSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="WideDashboard">
                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="SandboxSummaryCard.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="QuickActionsCard.(Grid.Row)" Value="0" />
                                            <Setter Target="QuickActionsCard.(Grid.Column)" Value="1" />
                                            <Setter Target="QuickActionsCard.(Grid.ColumnSpan)" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="SandboxSummaryCard" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SANDBOX" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Width="10" Height="10" Fill="{ThemeResource SandboxAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.SandboxStatus, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.SandboxDetail, Mode=OneWay}" Opacity="0.62" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                                            <Button Content="Start" Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.CanOperateSandbox, Mode=OneWay}" />
                                            <Button Content="Stop" Command="{x:Bind ViewModel.StopCommand}" IsEnabled="{x:Bind ViewModel.CanOperateSandbox, Mode=OneWay}" />
                                            <Button Content="Embedded terminal" Click="EmbeddedTerminal_Click" IsEnabled="{x:Bind ViewModel.CanOperateSandbox, Mode=OneWay}" />
                                            <Button Content="Windows Terminal" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenTerminalCommand}" IsEnabled="{x:Bind ViewModel.CanOperateSandbox, Mode=OneWay}" />
                                            <Button Content="Delete VM…" Click="DeleteSandbox_Click" IsEnabled="{x:Bind ViewModel.CanManageSandbox, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <InfoBar IsOpen="True" IsClosable="False"
                                             Severity="{x:Bind ViewModel.GuestConnectionSeverity, Mode=OneWay}"
                                             Title="{x:Bind ViewModel.GuestConnectionStatus, Mode=OneWay}"
                                             Message="{x:Bind ViewModel.GuestConnectionDetail, Mode=OneWay}">
                                        <InfoBar.ActionButton>
                                            <Button Content="Test connection" Command="{x:Bind ViewModel.TestConnectionCommand}" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>
                                    <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Resource usage" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ResourceUsageStatus, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="CPU" Opacity="0.55" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.CpuUsageLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}" Height="6" Visibility="{x:Bind ViewModel.ResourceUsageBarsVisibility, Mode=OneWay}" AutomationProperties.Name="CPU usage" />
                                            <TextBlock Text="{x:Bind ViewModel.CpuLabel, Mode=OneWay}" FontSize="12" Opacity="0.58" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="MEMORY" Opacity="0.55" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.MemoryUsageLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.MemoryUsagePercent, Mode=OneWay}" Height="6" Visibility="{x:Bind ViewModel.ResourceUsageBarsVisibility, Mode=OneWay}" AutomationProperties.Name="Memory usage" />
                                            <TextBlock Text="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}" FontSize="12" Opacity="0.58" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="7">
                                            <TextBlock Text="DISK" Opacity="0.55" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.DiskUsageLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.DiskUsagePercent, Mode=OneWay}" Height="6" Visibility="{x:Bind ViewModel.ResourceUsageBarsVisibility, Mode=OneWay}" AutomationProperties.Name="Disk usage" />
                                            <TextBlock Text="{x:Bind ViewModel.DiskLabel, Mode=OneWay}" FontSize="12" Opacity="0.58" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="QuickActionsCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Quick actions" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <Button HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.LoadGuestFilesCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" /><TextBlock Text="Browse workspace" /></StackPanel></Button>
                                    <Button HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.CreateSnapshotCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE777;" /><TextBlock Text="Create snapshot" /></StackPanel></Button>
                                    <TextBlock Text="{x:Bind ViewModel.OperationLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.55" Margin="2,6,2,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Agent presets" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Pinned tools install inside the VM. Authentication always stays inside the guest terminal." Opacity="0.6" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Presets}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Version}" FontSize="11" Opacity="0.55" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="FilesPanel" Visibility="Collapsed" Margin="32,8,32,32" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Host files" Style="{StaticResource SubtitleTextBlockStyle}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Click="HostUp_Click" ToolTipService.ToolTip="Parent folder"><FontIcon Glyph="&#xE74A;"/></Button><Button Click="ChooseHostFolder_Click" ToolTipService.ToolTip="Choose folder"><FontIcon Glyph="&#xE8B7;"/></Button></StackPanel></Grid>
                                <TextBox Grid.Row="1" Text="{x:Bind ViewModel.HostPath, Mode=OneWay}" IsReadOnly="True" Header="Windows" />
                                <ListView x:Name="HostList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.HostEntries}" SelectionMode="Multiple" DoubleTapped="HostList_DoubleTapped" CanDragItems="True" AllowDrop="True" Drop="HostList_Drop">
                                    <ListView.ItemTemplate><DataTemplate><Grid Padding="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Detail}" Opacity="0.5" /></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <Button Click="Upload_Click" ToolTipService.ToolTip="Upload selected files"><FontIcon Glyph="&#xE898;" /></Button>
                            <Button Click="Download_Click" ToolTipService.ToolTip="Download selected files"><FontIcon Glyph="&#xE896;" /></Button>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto"/><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Guest files" Style="{StaticResource SubtitleTextBlockStyle}"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><AutoSuggestBox x:Name="GuestSearchBox" Width="190" PlaceholderText="Search this folder" QuerySubmitted="GuestSearch_QuerySubmitted"/><ToggleButton x:Name="HiddenFilesToggle" Content="Hidden" Click="HiddenFiles_Click"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button x:Name="GuestRootButton" Content="System (read-only)" Click="GuestRoot_Click"/><Button Click="GuestUp_Click" ToolTipService.ToolTip="Parent folder"><FontIcon Glyph="&#xE74A;"/></Button><Button Command="{x:Bind ViewModel.LoadGuestFilesCommand}" ToolTipService.ToolTip="Refresh guest"><FontIcon Glyph="&#xE72C;" /></Button></StackPanel></Grid>
                                <TextBox Grid.Row="1" Text="{x:Bind ViewModel.GuestPath, Mode=OneWay}" IsReadOnly="True" Header="Ubuntu VM" />
                                <CommandBar x:Name="GuestActionsBar" Grid.Row="2" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False"><AppBarButton Icon="Add" Label="New" Click="GuestNew_Click"/><AppBarButton Icon="Rename" Label="Rename" Click="GuestRename_Click"/><AppBarButton Icon="Copy" Label="Duplicate" Click="GuestDuplicate_Click"/><AppBarButton Icon="MoveToFolder" Label="Move" Click="GuestMove_Click"/><AppBarButton Icon="Edit" Label="Edit" Click="GuestEdit_Click"/><AppBarButton Icon="Delete" Label="Trash" Click="GuestTrash_Click"/><AppBarButton Icon="Folder" Label="Archive" Click="GuestArchive_Click"/><AppBarButton Icon="OpenFile" Label="Extract" Click="GuestExtract_Click"/><AppBarButton Icon="Permissions" Label="Mode" Click="GuestMode_Click"/></CommandBar>
                                <ListView x:Name="GuestList" Grid.Row="3" ItemsSource="{x:Bind ViewModel.GuestEntries}" SelectionMode="Multiple" DoubleTapped="GuestList_DoubleTapped" AllowDrop="True" Drop="GuestList_Drop" CanDragItems="True" DragItemsStarting="GuestList_DragItemsStarting">
                                    <ListView.ItemTemplate><DataTemplate><Grid Padding="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Kind}" Opacity="0.5" /></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Transfer queue" FontWeight="SemiBold"/><ListView Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.TransferActivity}" MaxHeight="92"/><ComboBox x:Name="ConflictPicker" Grid.Column="2" Header="If destination exists" SelectedIndex="0" MinWidth="130"><ComboBoxItem Content="Stop" Tag="Fail"/><ComboBoxItem Content="Keep both" Tag="Rename"/><ComboBoxItem Content="Overwrite…" Tag="Overwrite"/></ComboBox><Button Grid.Column="3" Content="Cancel" Command="{x:Bind ViewModel.CancelTransferCommand}" IsEnabled="{x:Bind ViewModel.HasActiveTransfer, Mode=OneWay}"/></Grid></Border>
                </Grid>

                <ScrollViewer x:Name="RecoveryPanel" Visibility="Collapsed">
                    <StackPanel Margin="32,8,32,32" Spacing="16">
                        <Border Style="{StaticResource CardStyle}"><Grid><StackPanel><TextBlock Text="Snapshots" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Restore points are exact-target operations. Destructive restore always requires confirmation." Opacity="0.6" Margin="0,4,0,0" /></StackPanel><Button HorizontalAlignment="Right" Content="Create snapshot" Command="{x:Bind ViewModel.CreateSnapshotCommand}" /></Grid></Border>
                        <ListView ItemsSource="{x:Bind ViewModel.Snapshots}"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><Grid><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding InstanceName}" Opacity="0.5" /></StackPanel><Button HorizontalAlignment="Right" Content="Restore…" Click="RestoreSnapshot_Click" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                        <Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource DangerBorderBrush}"><StackPanel Spacing="8"><TextBlock Text="Recovery actions" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Rebuild never removes the workspace without a separately typed, exact-target confirmation. Uninstalling the app leaves the VM and workspace intact." TextWrapping="Wrap" Opacity="0.65" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Review trash" Click="ReviewTrash_Click"/><Button Content="Rebuild sandbox…" Click="Rebuild_Click" IsEnabled="{x:Bind ViewModel.CanOperateSandbox, Mode=OneWay}"/></StackPanel></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed">
                    <StackPanel Margin="32,8,32,32" Spacing="12">
                        <Border Style="{StaticResource CardStyle}"><Grid><StackPanel><TextBlock Text="System checks" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Structured, local-only diagnostics. No telemetry is collected." Opacity="0.6" /></StackPanel><Button HorizontalAlignment="Right" Content="Export diagnostic bundle" Click="ExportDiagnostics_Click"/></Grid></Border>
                        <ListView ItemsSource="{x:Bind ViewModel.Diagnostics}"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.65" /><TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="11" Opacity="0.4" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Margin="32,8,32,32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" /><ComboBox x:Name="ThemePicker" Header="Theme" SelectedIndex="2" Width="240" HorizontalAlignment="Left"><ComboBoxItem Content="Dark" Tag="Dark"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Use Windows setting" Tag="System"/></ComboBox><ToggleSwitch x:Name="ReducedMotionSwitch" Header="Reduced motion" OffContent="Follow Windows setting" OnContent="Reduced" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Updates &amp; privacy" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="UpdatesSwitch" Header="Check GitHub Releases" IsOn="True" OnContent="At most once daily" OffContent="Disabled" /><TextBox x:Name="ReleaseRepositoryBox" Header="GitHub repository (owner/name)" PlaceholderText="Configure after creating the GitHub repository"/><Button Content="Check now" HorizontalAlignment="Left" Click="CheckUpdates_Click"/><TextBlock Text="There is no telemetry, silent download, or automatic update. Release pages open only after you choose to view them." TextWrapping="Wrap" Opacity="0.62" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="Advanced" Style="{StaticResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="AdvancedBrowseSwitch" Header="Browse guest system files" OffContent="Workspace only" OnContent="Read-only outside workspace" /><TextBlock Text="The file manager never mutates system paths, follows symlink parents, changes ownership, or runs sudo." TextWrapping="Wrap" Opacity="0.62"/><Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveSettings_Click"/></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
